# Copy this file to .env.local and fill in what you need.
# Every integration below is optional and gracefully disables itself when unset,
# except the Firebase block, which is required (Firestore is the app's only database).

# ── Site URL ─────────────────────────────────────────────────────────
# Used to build absolute links in emails and metadata. Falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://astronomers.in

# ── Razorpay payments ────────────────────────────────────────────────
# RAZORPAY_MODE selects which key pair below is used: "test" (default) or "live".
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Legacy fallback if you don't use the test/live split above:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required to receive payment/subscription webhook events:
RAZORPAY_WEBHOOK_SECRET=

# ── Practitioner payout bank/UPI encryption ────────────────────────
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Required before practitioners can save bank/UPI payout details.
PAYOUT_ENCRYPTION_KEY=

# ── Transactional email (Resend) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Jyotish Studio <onboarding@resend.dev>"

# ── AI readings (Google Gemini) ─────────────────────────────────────
GEMINI_API_KEY=
# Optional daily cap on Gemini calls across the whole app (defaults to 2000 if unset):
GEMINI_DAILY_CALL_LIMIT=

# ── Realtime chat (Ably) ─────────────────────────────────────────────
ABLY_API_KEY=

# ── Firebase (required) ───────────────────────────────────────────────
# Auth, Firestore, and Storage all run on Firebase. Client config from your
# Firebase project settings (safe to expose to the browser):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side service account JSON (single line), from Firebase project settings → Service accounts:
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_STORAGE_BUCKET=
# Set to "true" to run against the local Firestore/Auth emulator instead of a real Firebase
# project — see "Local development against the Firebase emulator" below:
NEXT_PUBLIC_USE_EMULATOR=

# ── Supabase (migration target) ───────────────────────────────────────
# Server-side. Read by src/lib/supabase-config.ts and the scripts in scripts/.
# Nothing is routed to Postgres until SUPABASE_CUTOVER=true, so these are safe
# to add to a deployment days before cutover. See docs/supabase-migration.md.
SUPABASE_URL=
# Direct Postgres connection string, from Project Settings → Database:
SUPABASE_DB_URL=
# Server-side admin key — bypasses RLS. Either format works with the migration
# scripts: the legacy "service_role" JWT (starts eyJ…) or a new secret key
# (starts sb_secret_…). Supabase is retiring the legacy JWTs by end of 2026, so
# prefer a secret key. Never expose to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" ONLY at cutover. Ported code paths branch on this; leaving it
# unset means the app keeps using Firestore even when the credentials above are
# valid. See docs/supabase-migration.md.
SUPABASE_CUTOVER=false
# Supabase's CA bundle, PEM with newlines escaped as \n (same shape as
# FIREBASE_SERVICE_ACCOUNT_KEY). Project Settings → Database → SSL configuration →
# "Download certificate". Pins the database TLS connection to Supabase's issuer so
# the service_role connection password cannot be handed to an impersonating peer.
# If unset, Node's default trust store is used; a connection that fails loudly is
# preferable to one that succeeds against an unverified certificate.
SUPABASE_CA_CERT=
# The project's JWT secret (Project Settings → API Keys → JWT Secret). Required by
# src/lib/auth-verify.ts to accept Supabase-issued access tokens, and (from
# SUPABASE_CUTOVER onward) src/lib/app-session.ts to sign the app's own session
# cookies, whose key is HKDF-derived from this value. Server-side only — never a
# NEXT_PUBLIC_ variable. Safe to set early; it changes no behaviour until sign-in
# actually starts issuing Supabase tokens.
#
# Rotating it invalidates every session cookie, i.e. signs every user out. A value
# shorter than 16 characters is refused outright rather than silently accepted.
SUPABASE_JWT_SECRET=
# Destination bucket for the palm/face reading images. Leave unset to use "readings".
# The bucket must already exist and be private; migrate-storage-to-supabase.mjs
# does not create it.
SUPABASE_STORAGE_BUCKET=

# ── Supabase browser auth ─────────────────────────────────────────────
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time, so they
# must be present when the app is built, and only non-secret values belong here.
# NEXT_PUBLIC_SUPABASE_AUTH=supabase is the switch that moves sign-in off the
# Firebase SDK. It is INDEPENDENT of SUPABASE_CUTOVER — set it only once Auth
# users have been migrated, or nobody can sign in. Unset = Firebase SDK.
NEXT_PUBLIC_SUPABASE_AUTH=
# Project URL, same value as SUPABASE_URL above. The browser cannot read a
# server-only variable, hence the duplicate name.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable/anon key (Project Settings → API Keys). Public by design and
# safe in the bundle; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only, against a Postgres without a certificate. Never set this
# against a real Supabase endpoint.
PGSSLMODE=

# ── Cloudflare Turnstile (CAPTCHA on public free tools) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Error tracking (Sentry) ──────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Analytics & ad conversion tracking ────────────────────────────────
NEXT_PUBLIC_GA_ID=
# Meta (Facebook/Instagram) Pixel ID — from Meta Events Manager. Unset = no Meta Pixel loaded.
NEXT_PUBLIC_META_PIXEL_ID=


# QA only. Set to "true" ONLY on a staging/test deployment. Combined with `paymentBypass: true` on
# a member's Firestore document (Admin-SDK-writable only), it lets that one account use every paid
# feature at zero cost. Both conditions are required, so a bypass account created for staging stays
# inert if the same database is ever pointed at a production build. Never set this in production.
ALLOW_PAYMENT_BYPASS=false
