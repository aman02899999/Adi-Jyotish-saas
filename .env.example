# Copy this file to .env.local and fill in what you need.
# Every integration below is optional and gracefully disables itself when unset,
# except DATABASE_URL, which is required.

# ── Database (required) ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/adijyotish

# ── Site URL ─────────────────────────────────────────────────────────
# Used to build absolute links in emails and metadata. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL (set automatically on Vercel), then localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Razorpay payments ────────────────────────────────────────────────
# RAZORPAY_MODE selects which key pair below is used: "test" (default) or "live".
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Legacy fallback if you don't use the test/live split above:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required to receive payment/subscription webhook events:
RAZORPAY_WEBHOOK_SECRET=

# ── Practitioner payout bank/UPI encryption ────────────────────────
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Required before practitioners can save bank/UPI payout details.
PAYOUT_ENCRYPTION_KEY=

# ── Transactional email (Resend) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Jyotish Studio <onboarding@resend.dev>"

# ── AI readings (Google Gemini) ─────────────────────────────────────
GEMINI_API_KEY=

# ── Realtime chat (Ably) ─────────────────────────────────────────────
ABLY_API_KEY=

# ── Firebase Google sign-in ──────────────────────────────────────────
# Client config from your Firebase project settings (safe to expose to the browser):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side service account JSON (single line), from Firebase project settings → Service accounts:
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Cloudflare Turnstile (CAPTCHA on public free tools) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Error tracking (Sentry) ──────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Analytics (Google Analytics) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=
