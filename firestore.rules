rules_version = '2';

// The app only ever talks to Firestore through the Admin SDK on the server
// (src/lib/firestore.ts), which bypasses these rules entirely. No client-side
// Firebase SDK code reads/writes Firestore directly, so default-deny is correct.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
